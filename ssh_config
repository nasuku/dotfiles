Host *
    IdentityFile ~/.ssh/id_rsa
    TCPKeepAlive=yes
    ServerAliveInterval=15
    ServerAliveCountMax=6
    Compression=yes
    ControlMaster auto
    ControlPath /tmp/%r@%h:%p
    #ControlPath /tmp/%C
    #ControlPersist yes
    ControlPersist 2m
    IgnoreUnknown UseKeyChain
    UseKeychain yes
    AddKeysToAgent yes
    HashKnownHosts yes
    HostkeyAlgorithms +ssh-rsa
    PubkeyAcceptedAlgorithms +ssh-rsa
